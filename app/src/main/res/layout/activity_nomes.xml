<?xml version="1.0" encoding="utf-8"?>
<!-- Tela para informar os nomes das equipes: 2 EditText + botao Confirmar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootNomes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloNomes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/titulo_nomes"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLabelJogador1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/etNomeJogador1"
        android:text="@string/label_jogador_1"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/etNomeJogador1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nome_padrao"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:id="@+id/tvLabelJogador2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@+id/etNomeJogador2"
        android:text="@string/label_jogador_2"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/etNomeJogador2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nome_padrao_2"
        android:importantForAutofill="no"
        android:inputType="text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/btn_confirmar" />
</LinearLayout>
