<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela principal: 4 TextViews e 13 botoes.
  LinearLayout vertical raiz; cada linha de pontos e um LinearLayout
  horizontal com 5 botoes de peso igual (1:1:1:1:1).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Identificacao do Jogador 1 (2 TextViews lado a lado) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNomeJogador1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/jogador_1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPontuacaoJogador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/pontuacao_destaque"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Linha de botoes de pontos do Jogador 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnJogador1Mais1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_1" />

        <Button
            android:id="@+id/btnJogador1Mais3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_3" />

        <Button
            android:id="@+id/btnJogador1Mais6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_6" />

        <Button
            android:id="@+id/btnJogador1Mais9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_9" />

        <Button
            android:id="@+id/btnJogador1Mais12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mais_12" />
    </LinearLayout>

    <!-- Identificacao do Jogador 2 (2 TextViews lado a lado) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNomeJogador2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/jogador_2"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPontuacaoJogador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/pontuacao_destaque"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Linha de botoes de pontos do Jogador 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnJogador2Mais1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_1" />

        <Button
            android:id="@+id/btnJogador2Mais3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_3" />

        <Button
            android:id="@+id/btnJogador2Mais6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_6" />

        <Button
            android:id="@+id/btnJogador2Mais9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/mais_9" />

        <Button
            android:id="@+id/btnJogador2Mais12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mais_12" />
    </LinearLayout>

    <!-- Botoes de navegacao (MaterialButton com icones da biblioteca Material) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistorico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/btn_historico"
        android:text="@string/btn_historico"
        app:icon="@drawable/ic_history" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnZerar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/btn_zerar"
        android:text="@string/btn_zerar"
        app:icon="@drawable/ic_restart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNomes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/btn_nomes"
        android:text="@string/btn_nomes"
        app:icon="@drawable/ic_person" />
</LinearLayout>
